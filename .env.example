# Google Maps Embed API key. Copy this file to .env.local and insert your restricted key.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=YOUR_GOOGLE_MAPS_EMBED_API_KEY

# Inquiry email delivery via Resend. Never expose this key to browser code.
RESEND_API_KEY=YOUR_RESEND_API_KEY
INQUIRY_TO_EMAIL=support@trolink.cn
INQUIRY_FROM_EMAIL=TrolinkTek Website <inquiry@your-verified-domain.com>
